/**
 * Cloudflare Workers config, via the OpenNext adapter (opennext.js.org/cloudflare).
 *
 * Workers Free: commercial use allowed, 100,000 requests a day, no card. Over
 * a limit, requests fail until midnight UTC; nothing is ever charged.
 *
 * Secrets (FORMINIT_API_KEY) and NEXT_PUBLIC_SITE_URL live in the Cloudflare
 * dashboard, not here. NEXT_PUBLIC_ values are inlined at build time, so they
 * must be set as build variables too.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "anjali-vastu-portfolio",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "anjali-vastu-portfolio"
    },
    /* The blog's posts. Sitedesk is a separate Worker; the secret SITEDESK_READ_TOKEN lives in the Cloudflare dashboard. */
    {
      "binding": "SITEDESK",
      "service": "sitedesk"
    }
  ],
  /* next/image (the portrait). Free plan: 5,000 unique transformations a month, errors past that, never billed. */
  "images": {
    "binding": "IMAGES"
  },
  /* Contact-form abuse guard (src/lib/rate-limit.ts). Free, counted per Cloudflare location, so approximate. */
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  /* Fingerprints of Cal ID webhook messages already alerted on (src/lib/webhook-dedupe.ts), kept a week. Workers KV free tier. */
  "kv_namespaces": [{ "binding": "CAL_DEDUPE", "id": "2e3ca9bd43b34a50b92b096418a30b28" }]
}
