# The public origin. Used for metadataBase, canonicals and OG tags.
# Set this in Vercel to the .vercel.app host now, swap it when the real
# domain is configured. Never hardcode the host into tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Raises the Forminit rate limit from 1 req/5s to 5 req/s.
# Server-side only — it is read in the /api/contact Route Handler and
# never reaches the browser.
FORMINIT_API_KEY=

# Razorpay test keys for the /pay-test learning sandbox (npm run dev only;
# every sandbox route is a 404 in production). Real bookings are paid through
# Cal ID's Razorpay app, not these. The secret stays server-side — never give
# it a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret typed into Razorpay (Test mode) → Webhooks for the sandbox
# receiver. Must match exactly; it signs every delivery.
RAZORPAY_WEBHOOK_SECRET=
